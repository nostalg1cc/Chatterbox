{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nitro",
  "version": "0.1.64",
  "identifier": "io.github.nostalg1cc.dislight",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nitro",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "theme": "Dark"
      },
      {
        "label": "voice-hud",
        "url": "voice-hud.html",
        "title": "Nitro Voice",
        "width": 200,
        "height": 140,
        "minWidth": 40,
        "minHeight": 40,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' blob: https://lapjrxdgcbdseskmyfru.supabase.co https://res.cloudinary.com https://video.twimg.com",
        "font-src": "'self' data:",
        "frame-src": "https://www.youtube-nocookie.com",
        "connect-src": "'self' ipc: http://ipc.localhost https://lapjrxdgcbdseskmyfru.supabase.co wss://lapjrxdgcbdseskmyfru.supabase.co https://res.cloudinary.com https://api.cloudinary.com https://video.twimg.com"
      },
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwN0U4RDQ4OUU0ODAzRTgKUldUb0EwaWVTSTErMEtuRUhsUGhrazVDMFhCMnE4Q2Q5MjlhZGFSS1oxTUNCeWxPRlAxa01XNzMK",
      "endpoints": [
        "https://github.com/nostalg1cc/Chatterbox/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
