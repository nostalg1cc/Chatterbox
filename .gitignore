# Dead-code holding pen: files moved out of src/ instead of deleted, so a
# git revert alone won't bring them back - kept locally, never committed.
/BAK/
# Git Bash's `2>nul` doesn't hit the real null device on Windows the way
# cmd.exe's does - it creates a literal empty file named "nul" instead.
/nul
